# Copy to .env and fill in. All values are optional for local testing.

# Public URL of the site (used in text-message links)
BASE_URL=https://winterize.example.com
PORT=3000

# Staff passwords (CHANGE THESE) and a long random secret for login cookies
ADMIN_PASSWORD=tv2026
TECH_PASSWORD=randy
SESSION_SECRET=TerraVistaIrrigationWinterization2026

# Neighborhood
NEIGHBORHOOD_NAME=Terra Vista
# Appended to addresses before geocoding, e.g. "Rocklin, CA 95765"
ADDRESS_SUFFIX=Plymouth, MN 55446
TZ_NAME=America/Chicago
DEFAULT_DAY_CAPACITY=25

# Google Maps Platform: enable "Maps JavaScript API" and "Geocoding API"
GOOGLE_MAPS_API_KEY=AIzaSyCZWDaUiT7BVfQcZzT6dQuqrm53AwB6kEk
# Optional separate, unrestricted-by-referrer key for server-side geocoding
GOOGLE_MAPS_SERVER_KEY=
# Optional Map ID (Advanced Markers). DEMO_MAP_ID works for testing.
GOOGLE_MAPS_MAP_ID=

# Twilio SMS (leave blank to log texts instead of sending)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# ...or use a Messaging Service instead of a From number
TWILIO_MESSAGING_SERVICE_SID=

# SQLite database location (put this on a persistent disk in production)
DB_PATH=./data/winterization.db
